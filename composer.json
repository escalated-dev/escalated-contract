{
    "name": "escalated-dev/contract",
    "description": "The Escalated behaviour contract: the page manifest every backend must render, and language-neutral conformance fixtures every port runs against itself.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/escalated-dev/escalated-contract",
    "support": {
        "issues": "https://github.com/escalated-dev/escalated-contract/issues",
        "source": "https://github.com/escalated-dev/escalated-contract"
    },
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "Escalated\\Contract\\": "packages/composer/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Escalated\\Contract\\Tests\\": "runners/php/"
        }
    },
    "extra": {
        "escalated-contract": {
            "contract-dir": "packages/composer/contract",
            "pages": "packages/composer/contract/pages.json",
            "conformance-dir": "packages/composer/contract/conformance"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
